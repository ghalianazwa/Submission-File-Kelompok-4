{
  "info": {
    "name": "Mini-LMS Kelompok 4 - Submission File Service",
    "description": "Koleksi uji Submission File Service (port 8105). Isi variabel token (jalankan request Login atau tempel manual). Ubah base_url ke http://127.0.0.1:8101 jika menguji lewat API Gateway.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8105"
    },
    {
      "key": "auth_url",
      "value": "http://127.0.0.1:8102"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "assignment_id",
      "value": "asg-001"
    },
    {
      "key": "submission_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Login (Authentication Service, Kelompok 1)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Login berhasil (200)\", function () { pm.response.to.have.status(200); });",
              "const json = pm.response.json();",
              "// Nama field token mengikuti kontrak Kelompok 1 (modul memberi contoh data.token). Sesuaikan jika berbeda.",
              "pm.collectionVariables.set(\"token\", json.data.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"mahasiswa@example.com\",\n  \"password\": \"rahasia123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{auth_url}}/api/auth/login",
          "host": [
            "{{auth_url}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "description": "ASUMSI: kredensial dan bentuk body mengikuti contoh modul. Sesuaikan dengan kontrak Kelompok 1. Boleh dilewati jika token diisi manual pada variabel token."
      }
    },
    {
      "name": "1. Health check berhasil",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Health check (200)\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"meta.request_id ada\", function () { pm.expect(pm.response.json().meta.request_id).to.be.a(\"string\"); });",
              "pm.test(\"status healthy\", function () { pm.expect(pm.response.json().data.status).to.eql(\"healthy\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": ""
      }
    },
    {
      "name": "2. GET submission berhasil",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Daftar submission (200)\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"data berupa array\", function () { pm.expect(pm.response.json().data).to.be.an(\"array\"); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/submissions",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "submissions"
          ]
        },
        "description": ""
      }
    },
    {
      "name": "3. GET submission dengan assignment_id",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Filter assignment_id (200)\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"semua data sesuai assignment_id\", function () { pm.response.json().data.forEach(function (s) { pm.expect(s.assignment_id).to.eql(pm.collectionVariables.get(\"assignment_id\")); }); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/submissions?assignment_id={{assignment_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "submissions"
          ],
          "query": [
            {
              "key": "assignment_id",
              "value": "{{assignment_id}}"
            }
          ]
        },
        "description": ""
      }
    },
    {
      "name": "4. POST submission berhasil",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Submission dibuat (201)\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"meta.request_id ada\", function () { pm.expect(pm.response.json().meta.request_id).to.be.a(\"string\"); });",
              "const d = pm.response.json().data;",
              "pm.collectionVariables.set(\"submission_id\", d.id);",
              "pm.test(\"status submitted\", function () { pm.expect(d.status).to.eql(\"submitted\"); });",
              "pm.test(\"notifikasi terkirim (jika Notification Service menyala)\", function () { pm.expect(pm.response.json().meta.notification).to.be.oneOf([\"sent\", \"failed\"]); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/submissions",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "submissions"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"assignment_id\": \"{{assignment_id}}\",\n  \"file_name\": \"laporan.pdf\",\n  \"file_url\": \"uploads/laporan.pdf\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
