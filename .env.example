# Salin berkas ini menjadi .env lalu isi nilainya. JANGAN commit .env ke GitHub.
PORT=8105
HOST=0.0.0.0

# Harus SAMA dengan secret yang dipakai Authentication Service (Kelompok 1).
JWT_SECRET=

DATA_FILE=data/submissions.json

# Alamat service lain. Jika dikosongkan, nilai diambil dari services.json.
ASSIGNMENT_URL=http://127.0.0.1:8104
NOTIFICATION_URL=http://127.0.0.1:8106

# Path endpoint pada service lain (ASUMSI, sesuaikan dengan kontrak kelompok terkait).
ASSIGNMENT_LOOKUP_PATH=/api/assignments/:id
NOTIFICATION_PATH=/api/notifications

# Batas waktu tunggu panggilan antarservice (milidetik).
SERVICE_TIMEOUT_MS=3000

# Role yang boleh menghapus submission milik orang lain (ASUMSI), pisahkan dengan koma.
PRIVILEGED_ROLES=admin,dosen
